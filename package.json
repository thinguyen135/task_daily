{
  "name": "task-daily-pc",
  "version": "1.1.0",
  "description": "Task Daily Desktop App & Pomodoro Blocker",
  "author": "Task Daily",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.taskdaily.app",
    "productName": "Task Daily",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
